---
import BaseLayout from '../layouts/BaseLayout.astro';
import RobotTrail from '../components/RobotTrail.astro';
import FaqSection from '../components/FaqSection.astro';
import { getCollection } from 'astro:content';
import { NEGOCIO, ZONAS } from '../data/negocio';

const faqs = [
  {q:'¿En qué zonas instala IRM robots cortacésped?',a:'Toda la Comunidad de Madrid (15 municipios activos) y además Valladolid, Segovia y Toledo. Cádiz entra en fase 2: llámanos para apuntarte en lista de espera.'},
  {q:'¿Vais a cualquier punto de la Comunidad de Madrid?',a:'Sí. Nos desplazamos a norte, oeste, sur y sierra. La demostración y la instalación la hacemos nosotros en persona, sin transportistas ni subcontratas.'},
  {q:'¿Si mi municipio no está en la lista, podéis venir?',a:'A veces sí. Cuéntanos los metros de césped y la dirección y te decimos sobre la marcha si entramos en zona o te apuntamos en la lista de nuevas aperturas.'},
  {q:'¿Cuánto tardáis en llegar desde Madrid?',a:'Depende del municipio. En la periferia inmediata (Pozuelo, Boadilla, Alcobendas) estamos en menos de 30 minutos. En la sierra o el corredor del Henares, entre 40 y 60.'},
  {q:'¿Varía el precio del renting según la zona?',a:'No. Los tramos (660 € hasta 600 m², 760 € hasta 1.000 m²) son los mismos en toda la cobertura. En Fase 2 (Cádiz) el precio puede variar por logística de instalación.'},
];

const title = 'Zonas donde instalamos robots cortacésped | IRM Servicios';
const description = 'Zonas donde IRM instala robots cortacésped en renting: Comunidad de Madrid, Valladolid, Segovia, Toledo y Cádiz. Instalación, mantenimiento y averías incluidos.';
const schema = {
  '@context':'https://schema.org','@type':'BreadcrumbList',
  itemListElement:[
    {'@type':'ListItem',position:1,name:'Inicio',item:NEGOCIO.url+'/'},
    {'@type':'ListItem',position:2,name:'Zonas donde instalamos'},
  ],
};

const zonasContent = await getCollection('zonas');
const byId = (slug: string) => zonasContent.find((z) => z.id === slug);
---
<BaseLayout {title} {description} {schema}>
  <section class="irm-section irm-bg-hueso irm-hero">
    <div class="irm-container">
      <span class="irm-eyebrow">Zonas donde instalamos</span>
      <h1>Zonas donde instalamos robots cortacésped en <span class="irm-destacado--claro">renting</span></h1>
      <p class="irm-entradilla" style="color:var(--irm-gris);max-width:62ch">Madrid es nuestra base y donde instalamos la mayoría de robots. Fuera de Madrid trabajamos en Valladolid, Segovia, Toledo y Cádiz. Esta es la lista completa de cobertura.</p>
    </div>
  </section>

  <RobotTrail />

  <section class="irm-section" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">Base principal</span>
      <h2>Comunidad de Madrid: 15 municipios activos</h2>
      <p style="max-width:62ch;color:var(--irm-gris)">La mayor parte de nuestros clientes están en la periferia de Madrid, donde están los chalets con jardín. Vamos en persona a cualquier punto de la Comunidad: norte, oeste, sur y sierra.</p>
      <article class="irm-card" style="margin-top:2rem;max-width:720px">
        <h3>Red IRM Madrid</h3>
        <p style="color:var(--irm-gris)">Las Rozas, Pozuelo de Alarcón, Majadahonda, Boadilla del Monte, Villaviciosa de Odón, Tres Cantos, Alcobendas, San Sebastián de los Reyes, Collado Villalba, Torrelodones, Galapagar, Rivas-Vaciamadrid, Arganda del Rey, Villanueva de la Cañada y Valdemorillo.</p>
        <a href="/#reserva" class="irm-btn irm-btn-primary" style="margin-top:1rem">Pide tu demostración en Madrid <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
      </article>
    </div>
  </section>

  <section class="irm-section irm-bg-hueso" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">Fase 1 · ya activa</span>
      <h2>Otras provincias donde instalamos</h2>
      <p style="max-width:62ch;color:var(--irm-gris)">Fuera de Madrid trabajamos en estas tres provincias: visita técnica, instalación y mantenimiento. La demostración se descuenta de la cuota si contratas.</p>
      <div class="irm-grid irm-grid-3" data-stagger style="margin-top:2.5rem">
        {ZONAS.filter((z) => z.fase === 1).map((z) => {
          const info = byId(z.slug);
          return (
            <a href={`/robot-cortacesped-${z.slug}/`} class="irm-card irm-card--link">
              {info?.data.imagen && (<div class="irm-foto irm-foto--card"><img src={info.data.imagen.src} alt={info.data.alt} loading="lazy" /></div>)}
              <div class="irm-card-body">
                <h3>Robot cortacésped en {z.nombre}</h3>
                <p style="color:var(--irm-gris)">{info?.data.description ?? `Renting de robot cortacésped en ${z.nombre}: instalación, mantenimiento y averías incluidos.`}</p>
                <span class="irm-arrow">Ver {z.nombre} →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="irm-section" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">Fase 2 · próxima</span>
      <h2>Zonas donde abrimos próximamente</h2>
      <p style="max-width:62ch;color:var(--irm-gris)">Estamos preparando la logística para arrancar en Cádiz. Si quieres que te avisemos cuando empecemos a instalar en tu zona, llámanos y te apuntamos.</p>
      <div class="irm-grid irm-grid-2" style="margin-top:2.5rem">
        {ZONAS.filter((z) => z.fase === 2).map((z) => (
          <a href={`/robot-cortacesped-${z.slug}/`} class="irm-card irm-card--link">
            <div class="irm-card-body">
              <h3>{z.nombre} (fase 2)</h3>
              <p style="color:var(--irm-gris)">Llámanos para quedar en lista de espera.</p>
              <span class="irm-arrow">Ver {z.nombre} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} eyebrow="FAQ · Zonas" title="Preguntas frecuentes sobre las zonas donde instalamos" intro="Lo que nos preguntáis sobre cobertura y desplazamiento." />

  <section class="irm-section irm-bg-negro" data-anim>
    <div class="irm-container irm-cta-final">
      <div>
        <span class="irm-eyebrow">El último paso</span>
        <h2>¿No ves tu zona? Llámanos</h2>
        <p style="color:#B5B9B2">A veces podemos ir aunque no estemos en la lista. Cuéntanos los metros de césped y la dirección y te decimos sobre la marcha.</p>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.5rem">
          <a href="/demostracion/" class="irm-btn irm-btn-primary irm-on-dark">Pide tu demostración <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          <a href={`tel:+34${NEGOCIO.telefono}`} class="irm-btn irm-btn-secondary">{NEGOCIO.telefonoFormato}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
