---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RobotTrail from '../../components/RobotTrail.astro';
import FaqSection from '../../components/FaqSection.astro';
import { NEGOCIO } from '../../data/negocio';

const faqs = [
  {q:'¿Un robot cortacésped sirve para un campo de fútbol?',a:'Sí. El corte diario a altura uniforme es lo que mejor mantiene el césped de un campo deportivo. En superficies grandes instalamos varios robots coordinados por la app.'},
  {q:'¿Cuántos robots hacen falta para un campo de fútbol?',a:'Depende del tamaño. Un campo estándar (unos 7.000 m²) necesita varios robots trabajando en paralelo. Lo medimos en la visita y hacemos presupuesto cerrado.'},
  {q:'¿El robot puede cortar durante los entrenamientos?',a:'No conviene que cojan ni la línea del balón ni los pies de los jugadores. Se programa para cortar entre entrenamientos y partidos: de madrugada o cuando el campo está vacío.'},
  {q:'¿Qué pasa si un robot se para a mitad de liga?',a:'En menos de 7 días está arreglado o te instalamos otro cortando. El mantenimiento y las averías van dentro de la cuota anual: ningún gasto imprevisto para el club.'},
  {q:'¿Cómo se presenta a la junta directiva?',a:'Como una línea de presupuesto anual cerrada, sin gasto variable ni facturas sueltas. Entregamos el presupuesto por escrito tras la demostración.'},
];

const title = 'Robot cortacésped para campos de fútbol | Renting IRM Madrid';
const description = 'Robot cortacésped para campos de fútbol en Madrid: corte diario automático, mantenimiento y averías incluidos y un coste anual cerrado para el club.';
const schema = {
  '@context':'https://schema.org','@type':'BreadcrumbList',
  itemListElement:[
    {'@type':'ListItem',position:1,name:'Inicio',item:NEGOCIO.url+'/'},
    {'@type':'ListItem',position:2,name:'Profesionales',item:NEGOCIO.url+'/profesionales/'},
    {'@type':'ListItem',position:3,name:'Campos de fútbol'},
  ],
};
---
<BaseLayout {title} {description} {schema}>
  <section class="irm-section irm-bg-negro irm-hero">
    <div class="irm-container irm-hero-grid">
      <div>
        <span class="irm-eyebrow"><a href="/profesionales/" style="color:inherit">Profesionales</a> · Campos</span>
        <h1>Robot cortacésped para campos de fútbol y clubes <span class="irm-destacado">deportivos</span></h1>
        <p class="irm-entradilla">Corte diario automático, altura uniforme en todo el campo y un coste anual cerrado con mantenimiento y averías incluidos.</p>
        <ul class="irm-checks" data-stagger style="margin:1.5rem 0 2rem">
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Corta solo todos los días, programado entre entrenamientos y partidos</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Sin gasolina, sin ruido y sin horas de jardinero</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Si falla, otro robot en menos de 7 días</li>
        </ul>
        <div class="irm-hero-ctas"><a href="/demostracion/" class="irm-btn irm-btn-primary">Solicita una demostración en tu campo <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a></div>
      </div>
      <div class="irm-foto irm-foto--insignia"><img src="/img/robot-cortacesped-grandes-superficies-cenital.webp" alt="Vista cenital de una superficie amplia con las franjas del corte diario del robot IRM" loading="eager" fetchpriority="high"><div class="irm-insignia">RENTING<strong>IRM</strong>CLUBES</div></div>
    </div>
  </section>

  <RobotTrail />

  <section class="irm-section" data-anim>
    <div class="irm-container">
      <div class="irm-split">
        <div>
          <span class="irm-eyebrow">Corte diario automático</span>
          <h2>Mantenimiento del césped del campo de fútbol con corte diario <span class="irm-destacado--claro">automático</span></h2>
          <p style="color:var(--irm-gris)">El mantenimiento del césped de un campo de fútbol en Madrid se lleva muchas horas de jardinero y mucha gasolina. Con el robot, un cortacésped automático de batería, el corte es diario: sale cada día, corta un poco y vuelve a su base, y el césped se queda a la misma altura en todo el campo. Lo programamos entre entrenamientos y partidos, así que nunca está en el campo cuando están los jugadores. Sin ruido, sin humo y sin que nadie tenga que acordarse de cortar.</p>
        </div>
        <div class="irm-foto"><img src="/img/finca-cesped-cenital-dron.webp" alt="Césped de un campo con altura uniforme gracias al corte diario del robot" loading="lazy"></div>
      </div>
    </div>
  </section>

  <section class="irm-section irm-bg-hueso" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">Para la junta</span>
      <h2>Un coste anual cerrado para la junta directiva</h2>
      <p style="max-width:62ch;color:var(--irm-gris)">Si eres quien lleva el presupuesto del club, el renting de robot cortacésped te quita dos problemas: el gasto variable del césped y tener que explicar cada factura. Es un único pago al año, por transferencia, que incluye robot, instalación, mantenimiento y averías.</p>
      <div class="irm-grid irm-grid-3" data-stagger style="margin-top:2.5rem">
        <article class="irm-card"><span class="irm-chip irm-chip--soft"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg> Presupuesto</span><h3>Una línea de presupuesto</h3><p style="color:var(--irm-gris)">Un importe anual cerrado que presentas a la junta una vez y no vuelve a moverse: sin visitas extra, sin recambios, sin sorpresas.</p></article>
        <article class="irm-card"><span class="irm-chip irm-chip--soft"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Todo incluido</span><h3>Todo incluido</h3><p style="color:var(--irm-gris)">Robot, instalación sin cable perimetral ni obras, app configurada, mantenimiento de todo el año y averías. Un único interlocutor: IRM.</p></article>
        <article class="irm-card"><span class="irm-chip irm-chip--soft"><svg viewBox="0 0 24 24"><path d="M3 7h18M3 12h18M3 17h18"/></svg> Sin activos</span><h3>Sin activos ni almacén</h3><p style="color:var(--irm-gris)">El robot es de IRM: el club no inmoviliza dinero en una máquina ni la amortiza ni la guarda. Paga el servicio y punto.</p></article>
      </div>
      <p class="irm-nota" style="margin-top:1.5rem">Un campo de fútbol tiene unos 7.000 m², muy por encima de los tramos de jardín. Cuántos robots hacen falta y el precio anual: presupuesto a medida tras la demostración.</p>
    </div>
  </section>

  <section class="irm-section" data-anim>
    <div class="irm-container">
      <article class="irm-card irm-card--featured" style="max-width:900px;margin-inline:auto">
        <span class="irm-chip irm-chip--soft"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Protege al que firma</span>
        <h2 style="font-size:var(--irm-h3);margin-top:.5rem">Averías y sustitución en menos de <span class="irm-destacado--claro">7 días</span>, también en temporada</h2>
        <p style="color:var(--irm-gris)">Es el argumento que protege a quien firma. Si el robot se para a mitad de liga, nos llamas y en menos de 7 días está arreglado o hay otro cortando. La sustitución del robot cortacésped, el mantenimiento y las averías van dentro de la cuota: nadie en el club tiene que explicar un gasto que no estaba previsto.</p>
      </article>
    </div>
  </section>

  <section class="irm-section">
    <div class="irm-container"><div class="irm-cta-strip"><h3>¿Lo vemos en tu campo?</h3><a href="/demostracion/" class="irm-btn irm-btn-primary irm-on-dark">Solicita una demostración <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a></div></div>
  </section>

  <FaqSection faqs={faqs} eyebrow="FAQ · Campos de fútbol" title="Preguntas frecuentes sobre robots cortacésped en campos de fútbol" intro="Lo que nos preguntan clubes, delegados y mantenimiento municipal antes de pedir presupuesto." />

  <section class="irm-section irm-bg-lima">
    <div class="irm-container irm-cta-final">
      <div>
        <span class="irm-eyebrow" style="color:var(--irm-negro)">Demostración en tu campo</span>
        <h2>Solicita una demostración en tu campo</h2>
        <ul class="irm-checks irm-cta-list">
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Visita, medición e instalación de prueba. 175 € que se descuentan</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Presupuesto anual cerrado y por escrito para la junta</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Te llamamos nosotros, con experiencia en campos de fútbol</li>
        </ul>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.5rem">
          <a href="/demostracion/" class="irm-btn irm-btn-primary">Solicita tu demostración <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          <a href={`tel:+34${NEGOCIO.telefono}`} class="irm-btn irm-btn-secondary">{NEGOCIO.telefonoFormato}</a>
        </div>
      </div>
      <div class="irm-foto irm-foto--card" style="aspect-ratio:4/5"><img src="/img/robot-cortacesped-sustitucion-7-dias.webp" alt="Dos robots cortacésped IRM listos para la sustitución en 7 días en un club deportivo" loading="lazy"></div>
    </div>
  </section>
</BaseLayout>
