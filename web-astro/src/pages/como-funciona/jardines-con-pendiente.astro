---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RobotTrail from '../../components/RobotTrail.astro';
import FaqSection from '../../components/FaqSection.astro';
import { NEGOCIO } from '../../data/negocio';

const faqs = [
  {q:'¿Qué pendiente máxima acepta un robot cortacésped?',a:'Depende del modelo. Los robots que instalamos cubren pendientes razonables de jardín de chalet; en cuestas pronunciadas elegimos uno con tracción total. Lo medimos en la demostración antes de contratar.'},
  {q:'¿Vale un robot normal para un jardín con cuesta?',a:'La mayoría cubren pendiente suave. Para taludes, bajadas a la piscina o escalones de césped elegimos un modelo específico con tracción adecuada. El robot que te instalamos lo elegimos nosotros según tu jardín.'},
  {q:'¿Qué pasa si tengo dos zonas separadas por un escalón?',a:'Los robots sin cable perimetral se mueven entre zonas por el paso que les enseñas. Mapeamos las zonas y los caminos que puede pisar para que llegue de un lado del jardín al otro sin ayuda.'},
  {q:'¿La pendiente afecta al precio del renting?',a:'No. Los tramos de precio dependen solo de los metros de césped (660 €/año hasta 600 m² y 760 €/año hasta 1.000 m²). La pendiente no se cobra aparte.'},
  {q:'¿Qué pasa si el robot vuelca o se atasca en una cuesta?',a:'El robot tiene sensores de inclinación y parada. Si el modelo elegido no es el adecuado para tu pendiente, lo vemos en la demostración y no contratamos.'},
];

const title = 'Robot cortacésped para jardines con pendiente | IRM Madrid';
const description = 'Robot cortacésped para jardines con pendiente, cuestas y escalones de césped. Sin cable perimetral, instalación en una visita y sustitución en 7 días.';
const schema = {
  '@context':'https://schema.org','@type':'BreadcrumbList',
  itemListElement:[
    {'@type':'ListItem',position:1,name:'Inicio',item:NEGOCIO.url+'/'},
    {'@type':'ListItem',position:2,name:'Cómo funciona',item:NEGOCIO.url+'/como-funciona/'},
    {'@type':'ListItem',position:3,name:'Jardines con pendiente'},
  ],
};
---
<BaseLayout {title} {description} {schema}>
  <section class="irm-section irm-bg-hueso irm-hero">
    <div class="irm-container irm-hero-grid">
      <div>
        <span class="irm-eyebrow"><a href="/como-funciona/" style="color:inherit">Cómo funciona</a> · Pendientes</span>
        <h1>Robot cortacésped para jardines con <span class="irm-destacado--claro">pendiente</span></h1>
        <p class="irm-entradilla" style="color:var(--irm-gris)">Cuestas, taludes, escalones de césped o dos zonas separadas. Los robots que instalamos aceptan pendiente y lo comprobamos antes en una demostración.</p>
        <ul class="irm-checks" data-stagger style="margin:1.5rem 0 2rem">
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Hasta pendiente máxima [CONFIRMAR grados / %]</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Sin cable perimetral: también entre zonas separadas</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Si falla, otro robot en menos de 7 días</li>
        </ul>
        <div class="irm-hero-ctas"><a href="/demostracion/" class="irm-btn irm-btn-primary">Pide tu demostración <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a><a href="/precios/" class="irm-btn irm-btn-secondary">Ver precios</a></div>
      </div>
      <div class="irm-foto"><img src="/img/robot-cortacesped-pendiente-cuesta.webp" alt="Robot cortacésped subiendo una pendiente en un jardín de chalet de la periferia de Madrid" loading="eager" fetchpriority="high"></div>
    </div>
  </section>

  <RobotTrail />

  <section class="irm-section" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">Qué significa "pendiente"</span>
      <h2>Pendiente, cuesta y escalones de césped: cuándo encaja un robot cortacésped</h2>
      <p style="max-width:62ch;color:var(--irm-gris)">No todo el "jardín con pendiente" es igual. Lo que un robot cortacésped en pendiente puede resolver depende de la inclinación en grados, de si hay un escalón que salvar y de si la hierba viene de una zona a otra. Esto es lo que comprobamos en tu casa antes de instalar.</p>
      <div class="irm-grid irm-grid-3" data-stagger style="margin-top:2.5rem">
        <article class="irm-card"><h3>Pendiente suave y continua</h3><p style="color:var(--irm-gris)">La típica del chalet de la periferia: el jardín que baja hacia la piscina o la pérgola. Lo cubren casi todos nuestros modelos.</p></article>
        <article class="irm-card"><h3>Cuesta pronunciada</h3><p style="color:var(--irm-gris)">Taludes de la sierra, bajadas a la zona de barbacoa, bordes contra el muro. Elegimos un modelo con mejor tracción.</p></article>
        <article class="irm-card"><h3>Zonas separadas por escalón</h3><p style="color:var(--irm-gris)">Jardín delantero y trasero conectados por un paso estrecho. Lo mapeamos para que el robot pase sin ayuda.</p></article>
      </div>
    </div>
  </section>

  <section class="irm-section irm-bg-hueso" data-anim>
    <div class="irm-container">
      <div class="irm-split">
        <div>
          <span class="irm-eyebrow">Instalación en pendiente</span>
          <h2>Cómo instalamos el robot en un jardín con <span class="irm-destacado--claro">cuesta</span></h2>
          <p style="color:var(--irm-gris)">Instalar un robot cortacésped en jardín con pendiente no es más complicado: lo que cambia es la medición. Vamos a tu casa, miramos la inclinación, los bordes contra el muro y las zonas por donde el robot va a pasar entre pisos del jardín. Después escogemos el modelo y lo dejamos cortando el mismo día.</p>
          <ul class="irm-checks" style="margin-top:1.5rem">
            <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Medición de pendiente real en el jardín</li>
            <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Elección del modelo según tracción</li>
            <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Mapeado sin cable perimetral</li>
          </ul>
          <p style="margin-top:1.5rem"><a href="/como-funciona/">Cómo funciona paso a paso →</a></p>
        </div>
        <div class="irm-foto"><img src="/img/robot-cortacesped-pendiente-cuesta.webp" alt="Robot cortacésped eléctrico trabajando en una cuesta de césped" loading="lazy"></div>
      </div>
    </div>
  </section>

  <section class="irm-section irm-bg-negro" data-anim>
    <div class="irm-container">
      <article class="irm-card irm-card--featured" style="max-width:900px;margin-inline:auto;background:transparent;border:1px solid rgba(255,255,255,.1)">
        <span class="irm-chip irm-chip--soft"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Protección total</span>
        <h2 style="font-size:var(--irm-h3);margin-top:.5rem;color:var(--irm-blanco)">Si el robot falla en pendiente, otro en menos de <span class="irm-destacado">7 días</span></h2>
        <p style="color:#B5B9B2">Las cuchillas y la tracción sufren más en cuesta. Por eso el mantenimiento, los recambios y la sustitución entran en la cuota: te garantizamos otro cortando antes de 7 días si hace falta.</p>
      </article>
    </div>
  </section>

  <FaqSection faqs={faqs} eyebrow="FAQ · Pendiente" title="Preguntas frecuentes sobre robots cortacésped en jardines con pendiente" intro="Lo que nos preguntáis cuando el jardín tiene cuesta." />

  <section class="irm-section irm-bg-negro">
    <div class="irm-container irm-cta-final">
      <div>
        <span class="irm-eyebrow">El último paso</span>
        <h2>¿Lo vemos en tu jardín con pendiente?</h2>
        <ul class="irm-checks irm-cta-list">
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Medición en tu jardín de la pendiente real</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Elegimos el robot que encaja con tu cuesta</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Si no sirve, no te cuesta nada</li>
        </ul>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.5rem">
          <a href="/demostracion/" class="irm-btn irm-btn-primary irm-on-dark">Reserva tu demostración <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          <a href={`tel:+34${NEGOCIO.telefono}`} class="irm-btn irm-btn-secondary">{NEGOCIO.telefonoFormato}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
