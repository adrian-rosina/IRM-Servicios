---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NEGOCIO } from '../../data/negocio';

export async function getStaticPaths() {
  const posts = await getCollection('articulos', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const published = post.data.fecha.toISOString();
const updated = (post.data.actualizado ?? post.data.fecha).toISOString();

// Posts relacionados (todos menos el actual, max 2)
const todosLosPosts = await getCollection('articulos', ({ data }) => !data.draft);
const relacionados = todosLosPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => +b.data.fecha - +a.data.fecha)
  .slice(0, 2);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.titulo,
    description: post.data.description,
    datePublished: published,
    dateModified: updated,
    author: { '@type': 'Organization', name: post.data.autor, url: NEGOCIO.url },
    publisher: { '@type': 'Organization', name: NEGOCIO.nombre, url: NEGOCIO.url },
    mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(`/blog/${post.id}/`, Astro.site).toString() },
    image: post.data.portada ? new URL(post.data.portada, Astro.site).toString() : undefined,
    keywords: [post.data.keyword, ...post.data.tags].join(', '),
    articleSection: post.data.categoria,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: NEGOCIO.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Blog',   item: NEGOCIO.url + '/blog/' },
      { '@type': 'ListItem', position: 3, name: post.data.titulo },
    ],
  },
];

const fechaES = (d: Date) => d.toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.description} ogImage={post.data.portada} {schema}>
  <!-- Barra de progreso de lectura -->
  <div class="irm-reading-progress" aria-hidden="true" data-reading-progress><span></span></div>

  <article class="irm-post">
    <!-- Hero del artículo -->
    <header class="irm-post-hero">
      <div class="irm-container">
        <nav aria-label="Breadcrumbs" class="irm-post-breadcrumbs">
          <a href="/">Inicio</a>
          <span>›</span>
          <a href="/blog/">Blog</a>
          <span>›</span>
          <span>{post.data.categoria}</span>
        </nav>
        <span class="irm-post-badge">{post.data.categoria}</span>
        <h1 class="irm-post-title">{post.data.titulo}</h1>
        <p class="irm-post-excerpt">{post.data.extracto}</p>
        <div class="irm-post-meta">
          <div class="irm-post-author">
            <span class="irm-post-author__avatar" aria-hidden="true">IRM</span>
            <div>
              <strong>{post.data.autor}</strong>
              <small>Equipo IRM Servicios</small>
            </div>
          </div>
          <div class="irm-post-stats">
            <span><time datetime={published}>{fechaES(post.data.fecha)}</time></span>
            {post.data.minutos && <><span class="irm-post-stats__sep">·</span><span>{post.data.minutos} min lectura</span></>}
            {post.data.actualizado && <><span class="irm-post-stats__sep">·</span><span>Actualizado {fechaES(post.data.actualizado)}</span></>}
          </div>
        </div>
      </div>
    </header>

    <!-- Portada full-width -->
    {post.data.portada && (
      <figure class="irm-post-cover">
        <img src={post.data.portada} alt={post.data.alt ?? post.data.titulo} loading="eager" fetchpriority="high" />
      </figure>
    )}

    <!-- Cuerpo del artículo -->
    <div class="irm-container irm-post-body">
      <div class="irm-article"><Content /></div>

      <!-- Tags -->
      {post.data.tags.length > 0 && (
        <div class="irm-post-tags">
          <span>Etiquetas:</span>
          {post.data.tags.map((t) => <span class="irm-post-tag">#{t}</span>)}
        </div>
      )}

      <!-- Compartir -->
      <div class="irm-post-share">
        <span>¿Te ha servido? Compártelo:</span>
        <a href={`https://wa.me/?text=${encodeURIComponent(post.data.titulo + ' · ' + NEGOCIO.url + '/blog/' + post.id + '/')}`} target="_blank" rel="noopener" aria-label="Compartir por WhatsApp">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          WhatsApp
        </a>
        <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(NEGOCIO.url + '/blog/' + post.id + '/')}&text=${encodeURIComponent(post.data.titulo)}`} target="_blank" rel="noopener" aria-label="Compartir en Twitter/X">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          Twitter
        </a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(NEGOCIO.url + '/blog/' + post.id + '/')}`} target="_blank" rel="noopener" aria-label="Compartir en LinkedIn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
      </div>
    </div>
  </article>

  <!-- Posts relacionados -->
  {relacionados.length > 0 && (
    <section class="irm-section irm-bg-hueso" data-anim>
      <div class="irm-container">
        <span class="irm-eyebrow">Seguir leyendo</span>
        <h2>Artículos relacionados</h2>
        <div class="irm-blog-grid" data-stagger>
          {relacionados.map((p) => (
            <a href={`/blog/${p.id}/`} class="irm-blog-card">
              <div class="irm-blog-card__img">
                {p.data.portada && <img src={p.data.portada} alt={p.data.alt ?? p.data.titulo} loading="lazy" />}
                <span class="irm-blog-card__badge">{p.data.categoria}</span>
              </div>
              <div class="irm-blog-card__body">
                <div class="irm-blog-meta">
                  <time datetime={p.data.fecha.toISOString()}>{fechaES(p.data.fecha)}</time>
                  {p.data.minutos && <><span>·</span><span>{p.data.minutos} min</span></>}
                </div>
                <h3>{p.data.titulo}</h3>
                <p>{p.data.extracto}</p>
                <span class="irm-blog-card__cta">Leer artículo →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA final -->
  <section class="irm-section irm-bg-negro">
    <div class="irm-container irm-cta-final">
      <div>
        <span class="irm-eyebrow">¿Lo probamos en tu jardín?</span>
        <h2>Reserva tu demostración de robot cortacésped en <span class="irm-destacado">Madrid</span></h2>
        <p style="color:#B5B9B2">Vamos a tu casa, medimos el césped y dejamos un robot cortando de prueba. Los {NEGOCIO.demoEuros} € se descuentan de la cuota si contratas el renting.</p>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.5rem">
          <a href="/demostracion/" class="irm-btn irm-btn-primary irm-on-dark">Pide tu demostración <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          <a href="/precios/" class="irm-btn irm-btn-secondary">Ver precios</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const bar = document.querySelector('[data-reading-progress] span');
      if (!bar) return;
      const update = () => {
        const h = document.documentElement;
        const scrolled = h.scrollTop;
        const total = h.scrollHeight - h.clientHeight;
        const p = total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0;
        bar.style.width = p + '%';
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    })();
  </script>
</BaseLayout>
