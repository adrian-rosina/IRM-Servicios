---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getCollection } from 'astro:content';
import { NEGOCIO } from '../../data/negocio';

const posts = (await getCollection('articulos', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.fecha - +a.data.fecha);

const categorias = Array.from(new Set(posts.map((p) => p.data.categoria))).sort();
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog · IRM Servicios',
    url: new URL('/blog/', Astro.site).toString(),
    description: 'Guías y comparativas sobre robots cortacésped en renting en Madrid.',
    publisher: { '@type': 'Organization', name: NEGOCIO.nombre, url: NEGOCIO.url },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.titulo,
      datePublished: p.data.fecha.toISOString(),
      url: new URL(`/blog/${p.id}/`, Astro.site).toString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: NEGOCIO.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Blog' },
    ],
  },
];

const faqs = [
  {q:'¿Qué temas se tratan en el blog de IRM Servicios?',a:'Guías honestas sobre robots cortacésped en Madrid: precio del renting, comparativas con jardinero, cómo elegir modelo, instalación sin cable perimetral, pendientes y zonas separadas.'},
  {q:'¿Cada cuánto publicáis artículos nuevos?',a:'Publicamos cuando tenemos algo útil que decir. Mejor pocos artículos con datos reales que mucho contenido vacío.'},
  {q:'¿Puedo citar artículos del blog en redes o en otra web?',a:'Sí, con atribución y enlace al artículo original.'},
];
---
<BaseLayout
  title="Blog sobre robots cortacésped en Madrid · IRM Servicios"
  description="Guías honestas sobre robots cortacésped en renting en Madrid: precios, comparativas con jardinero, cómo elegir modelo, instalación sin cable perimetral."
  {schema}>

  <!-- Grid principal con filtros -->
  <section class="irm-section irm-blog-list" data-anim>
    <div class="irm-container">
      <h1 class="irm-blog-list__title">Últimas publicaciones</h1>

      <div class="irm-blog-filters" role="tablist" aria-label="Filtrar por categoría">
        <button type="button" class="irm-blog-filter is-active" data-filter="all" role="tab" aria-selected="true">Todo</button>
        {categorias.map((cat) => (
          <button type="button" class="irm-blog-filter" data-filter={slug(cat)} role="tab" aria-selected="false">{cat}</button>
        ))}
      </div>

      <div class="irm-blog-grid" data-blog-grid data-stagger>
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="irm-blog-card" data-cat={slug(post.data.categoria)}>
            <div class="irm-blog-card__img">
              {post.data.portada && <img src={post.data.portada} alt={post.data.alt ?? post.data.titulo} loading="lazy" />}
              <span class="irm-blog-card__badge">{post.data.categoria}</span>
            </div>
            <div class="irm-blog-card__body">
              <h3>{post.data.titulo}</h3>
            </div>
          </a>
        ))}
      </div>

      <p class="irm-blog-list__empty" data-blog-empty hidden>No hay artículos en esta categoría todavía.</p>
    </div>

    <script is:inline>
      (() => {
        const filters = document.querySelectorAll('.irm-blog-filter');
        const grid = document.querySelector('[data-blog-grid]');
        const empty = document.querySelector('[data-blog-empty]');
        if (!grid || !filters.length) return;
        const cards = grid.querySelectorAll('.irm-blog-card');
        filters.forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = btn.getAttribute('data-filter');
            filters.forEach((b) => { b.classList.remove('is-active'); b.setAttribute('aria-selected', 'false'); });
            btn.classList.add('is-active'); btn.setAttribute('aria-selected', 'true');
            let visible = 0;
            cards.forEach((c) => {
              const match = target === 'all' || c.getAttribute('data-cat') === target;
              c.hidden = !match;
              if (match) visible++;
            });
            if (empty) empty.hidden = visible > 0;
          });
        });
      })();
    </script>
  </section>

  <!-- CTA -->
  <section class="irm-section irm-bg-negro" data-anim>
    <div class="irm-container irm-cta-final">
      <div>
        <span class="irm-eyebrow">¿Lo probamos en tu jardín?</span>
        <h2>Mejor que leer sobre robots: ver <span class="irm-destacado">uno cortando</span> tu césped</h2>
        <p style="color:#B5B9B2">Vamos a tu casa, medimos el jardín y te dejamos un robot cortando de prueba. Si contratas, los {NEGOCIO.demoEuros} € de la demostración se descuentan de la cuota anual.</p>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.5rem">
          <a href="/demostracion/" class="irm-btn irm-btn-primary irm-on-dark">Reserva tu robot <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          <a href={`tel:+34${NEGOCIO.telefono}`} class="irm-btn irm-btn-secondary">{NEGOCIO.telefonoFormato}</a>
        </div>
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} eyebrow="FAQ · Blog" title="Preguntas frecuentes sobre el blog" />
</BaseLayout>
