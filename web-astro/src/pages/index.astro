---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { NEGOCIO, TRAMOS, ZONAS, precioDia } from '../data/negocio';
import heroImg from '../assets/robot-cortacesped-madrid-amanecer-hero.webp';

const title = 'Alquiler de robots cortacésped en Madrid | Renting · IRM';
const description = 'Renting anual de robot cortacésped en Madrid desde 660 €/año: instalación sin cable, mantenimiento y averías incluidos. Si falla, otro en menos de 7 días.';

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'LocalBusiness',
    '@id': `${NEGOCIO.url}/#negocio`,
    name: NEGOCIO.nombre, url: NEGOCIO.url,
    telephone: `+34${NEGOCIO.telefono}`,
    areaServed: ['Comunidad de Madrid', 'Valladolid', 'Segovia', 'Toledo', 'Cádiz'],
    priceRange: '€€',
    sameAs: [`https://instagram.com/${NEGOCIO.instagram}`],
  },
  {
    '@context': 'https://schema.org', '@type': 'Service',
    serviceType: 'Renting anual de robot cortacésped',
    areaServed: 'Madrid',
    provider: { '@id': `${NEGOCIO.url}/#negocio` },
    offers: TRAMOS.map((t) => ({
      '@type': 'Offer',
      name: `Hasta ${t.metros} m²`,
      price: t.precioAnual, priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
    })),
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: '¿Tengo que comprar el robot?', acceptedAnswer: { '@type': 'Answer', text: 'No. Es renting anual: pagas una cuota al año y el robot, la instalación, el mantenimiento y las averías van incluidos.' }},
      { '@type': 'Question', name: '¿Qué pasa si se estropea?', acceptedAnswer: { '@type': 'Answer', text: 'Nos llamas y en menos de 7 días lo tienes arreglado o te instalamos otro. El mantenimiento y las averías ya están pagados con la cuota.' }},
      { '@type': 'Question', name: '¿Se puede pagar al mes?', acceptedAnswer: { '@type': 'Answer', text: 'El renting es anual y se paga en un solo pago por transferencia. 660 €/año son menos de 2 € al día.' }},
      { '@type': 'Question', name: '¿Puedo cogerlo solo en verano?', acceptedAnswer: { '@type': 'Answer', text: 'No, el servicio es anual. En invierno el robot descansa en su base, pero el mantenimiento, la app y la sustitución siguen activos.' }},
      { '@type': 'Question', name: '¿Vale para mi jardín con cuesta o varias zonas?', acceptedAnswer: { '@type': 'Answer', text: 'En la mayoría de los casos, sí. Los robots que instalamos no necesitan cable perimetral y aceptan pendiente. Lo comprobamos en la demostración.' }},
      { '@type': 'Question', name: '¿Qué pasa cuando termina el año?', acceptedAnswer: { '@type': 'Answer', text: 'No hay permanencia más allá del año contratado. Si renuevas, seguimos igual; si no, retiramos el robot y la base.' }},
    ],
  },
];
---
<BaseLayout {title} {description} {schema}>

  <!-- S1 · HERO con vídeo + cifra -->
  <section class="irm-section irm-bg-negro irm-hero irm-hero--big">
    <div class="irm-container irm-hero-grid">
      <div>
        <span class="irm-eyebrow">Tu césped se corta <span class="irm-destacado">solo.</span></span>
        <h1>Alquiler de robots cortacésped en Madrid</h1>
        <p class="irm-entradilla">Renting anual con instalación, mantenimiento y averías incluidos. Sin cable perimetral y también para jardines con pendiente.</p>
        <ul class="irm-checks" data-stagger style="margin:1.5rem 0 1rem">
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Corta solo, todos los días</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Silencioso y sin gasolina</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Si falla, otro en menos de 7 días</li>
        </ul>
        <div class="irm-pill-precio"><span class="irm-nota" style="color:#D4D7D4">Desde</span><strong>660 €/año*</strong></div>
        <p class="irm-nota" style="color:#9BA09C;margin-top:.5rem">* Hasta 600 m². Menos de 2 € al día.</p>
        <div class="irm-hero-ctas">
          <a href="/demostracion/" class="irm-btn irm-btn-primary">Reserva tu robot <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          <a href="/precios/" class="irm-btn irm-btn-secondary">Ver precios</a>
        </div>
        <div class="irm-hero-tel"><span>Llama a</span> <a href={`tel:+34${NEGOCIO.telefono}`}>{NEGOCIO.telefonoFormato}</a></div>
      </div>
      <div class="irm-foto irm-foto--insignia">
        <video autoplay muted loop playsinline preload="metadata" poster={heroImg.src}>
          <source src="/video/hero.mp4" type="video/mp4">
          <source src="/video/hero.webm" type="video/webm">
          <Image src={heroImg} alt="Robot cortacésped IRM instalado en jardín de Madrid" widths={[600,1200,1600]} sizes="(max-width:1024px) 100vw, 50vw" loading="eager" fetchpriority="high" />
        </video>
        <div class="irm-chips-flotantes" data-stagger>
          <span class="irm-chip"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Corta cada día</span>
          <span class="irm-chip"><svg viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/></svg> Silencioso</span>
          <span class="irm-chip"><svg viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg> Desde el móvil</span>
        </div>
        <div class="irm-insignia">RENTING<strong>IRM</strong>CON SERVICIO</div>
      </div>
    </div>
  </section>

  <!-- S2 · QUÉ ES (4 cards) -->
  <section class="irm-section" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">El renting</span>
      <h2>Tu robot cortacésped en Madrid, sin <span class="irm-destacado--claro">comprarlo</span></h2>
      <p style="max-width:62ch;color:var(--irm-gris)">Pagas una cuota al año y te olvidas del césped. El robot es nuestro, el jardín es tuyo: lo instalamos, lo mantenemos y, si se estropea, lo cambiamos. Lo llaman de muchas formas: cortacésped automático, robot segadora, segadora automática, cortacésped que va solo. Nosotros lo llamamos la forma más fácil de tener el césped bien en Madrid.</p>
      <div class="irm-grid irm-grid-4" data-stagger style="margin-top:2.5rem">
        <article class="irm-card"><span class="irm-chip irm-chip--soft"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Diario</span><h3>Corta solo, todos los días</h3><p style="color:var(--irm-gris)">Un cortador de césped automático que sale cada día, corta un poco y vuelve a su base. El césped está siempre a la misma altura, sin que tengas que acordarte.</p></article>
        <article class="irm-card"><span class="irm-chip irm-chip--soft"><svg viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/></svg> Silencio</span><h3>Silencioso</h3><p style="color:var(--irm-gris)">No molesta a tus vecinos ni a tu siesta. Puede cortar por la mañana temprano o mientras no estás en casa.</p></article>
        <article class="irm-card"><span class="irm-chip irm-chip--soft"><svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg> Eléctrico</span><h3>Sin gasolina ni cables</h3><p style="color:var(--irm-gris)">Un robot cortacésped eléctrico, con batería y sin cable perimetral. Nada de bidones, nada de zanjas en el jardín.</p></article>
        <article class="irm-card"><span class="irm-chip irm-chip--soft"><svg viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg> App</span><h3>Lo controlas desde el móvil</h3><p style="color:var(--irm-gris)">Horarios, zonas y altura desde la app: un cortacésped inteligente que Pepo te deja configurado el día de la instalación.</p></article>
      </div>
    </div>
  </section>

  <!-- S3 · QUÉ INCLUYE (6 checks + 2 destacados) -->
  <section class="irm-section irm-bg-hueso" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">Qué incluye</span>
      <h2>Qué incluye el renting del robot cortacésped</h2>
      <p style="max-width:62ch;color:var(--irm-gris)">Con el alquiler del robot cortacésped tienes todo lo que hace falta para que el césped se corte solo durante un año entero. No compras nada, no mantienes nada y no llamas a ningún servicio técnico: para eso estamos nosotros.</p>
      <div style="display:grid;gap:2rem;margin-top:2rem" class="irm-split">
        <ul class="irm-checks">
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span><span><strong>El robot cortacésped</strong>, a tu medida de jardín</span></li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span><span><strong>Instalación sin cable perimetral</strong> y sin obras</span></li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span><span><strong>Puesta a punto</strong> el mismo día</span></li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span><span><strong>La app configurada</strong> en tu móvil</span></li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span><span><strong>Mantenimiento</strong> durante todo el año</span></li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span><span><strong>Averías y reparaciones</strong></span></li>
        </ul>
        <div style="display:grid;gap:1rem">
          <article class="irm-card irm-card--featured"><h3>Mantenimiento y averías incluidos durante todo el año</h3><p style="color:var(--irm-gris)">Cuchillas, limpieza, ajustes, lo que sea. Cualquier fallo que te dé el robot, te despreocupas: lo resolvemos nosotros y no te cuesta más.</p></article>
          <article class="irm-card irm-card--featured"><h3>Si falla, te ponemos otro en menos de <span class="irm-destacado--claro">7 días</span></h3><p style="color:var(--irm-gris)">Si un día no arranca, nos llamas. En menos de 7 días lo tienes arreglado o te instalamos otro. El césped no espera y nosotros tampoco.</p></article>
        </div>
      </div>
    </div>
  </section>

  <!-- S3b · MANTENIMIENTO/REPARACIÓN -->
  <section class="irm-section" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">Si falla, no es tu problema</span>
      <h2>Un robot cortacésped con mantenimiento y averías <span class="irm-destacado--claro">incluidos</span></h2>
      <p style="max-width:62ch;color:var(--irm-gris)">Nadie en el sector da un plazo por escrito cuando algo se rompe. Nosotros sí. Cuchillas, limpieza, ajustes, piezas de desgaste y cualquier avería entran en la cuota.</p>
      <div class="irm-reparacion" style="margin-top:2.5rem">
        <article class="irm-reparacion-card">
          <span class="irm-eyebrow" style="color:var(--irm-lima)">Plazo máximo de sustitución</span>
          <div class="irm-cifra-grande">7<small>días como máximo si no se arregla antes</small></div>
          <ul class="irm-checks">
            <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Mantenimiento del robot incluido todo el año</li>
            <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Avería cubierta: la factura es nuestra</li>
            <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Robot de sustitución en menos de 7 días</li>
          </ul>
        </article>
        <div class="irm-foto"><img src="/img/robot-cortacesped-reparacion-mantenimiento.webp" alt="Robot cortacésped IRM abierto en el taller durante una reparación" loading="lazy"></div>
      </div>
    </div>
  </section>

  <!-- S4 · PRECIO -->
  <section class="irm-section irm-bg-hueso" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">Precio</span>
      <h2>Cuánto cuesta el alquiler de un robot cortacésped: menos de 2 € al día</h2>
      <p style="max-width:62ch;color:var(--irm-gris)">Un solo pago al año según el tamaño de tu césped. Sin cuotas escondidas, sin mantenimiento aparte, sin sorpresas cuando algo se rompe.</p>
      <div class="irm-grid irm-grid-2" data-stagger style="margin-top:2.5rem">
        {TRAMOS.map((t) => (
          <article class={`irm-card irm-price-card ${t.destacado ? 'irm-price-card--dark' : ''}`}>
            {t.destacado && <span class="irm-etiqueta">La más contratada</span>}
            <span class="irm-etiqueta" style={t.destacado ? 'background:transparent;color:#D4D7D4;padding:0' : ''}>{t.etiqueta}</span>
            <div>
              <span class="irm-cifra-tramo">{t.precioAnual} €<span style="font-size:1.125rem;font-weight:500;color:var(--irm-gris)">/año</span></span>
              <p class="irm-nota" style="margin-top:.25rem">{precioDia(t.precioAnual)} € al día · pago anual*</p>
            </div>
            <ul class="irm-checks">
              <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Robot e instalación sin cable</li>
              <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>App configurada</li>
              <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Mantenimiento todo el año</li>
              <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Averías y sustitución en 7 días</li>
            </ul>
            <a href="/demostracion/" class={`irm-btn ${t.destacado ? 'irm-btn-primary irm-on-dark' : 'irm-btn-secondary'}`}>Calcula tu cuota <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
          </article>
        ))}
      </div>
      <p class="irm-nota" style="margin-top:1.5rem">*Precio anual, IVA incluido [CONFIRMAR]. Jardines de más de 1.000 m²: consúltanos.</p>
      <p style="margin-top:.75rem">¿Comprarlo por tu cuenta? Entre 950 y 6.000 € más instalación y mantenimiento aparte → <a href="/precios/">compara en /precios/</a></p>
    </div>
  </section>

  <!-- S5 · SIN CABLE + TIPOS DE JARDÍN -->
  <section class="irm-section" data-anim>
    <div class="irm-container">
      <div class="irm-split">
        <div>
          <span class="irm-eyebrow">Instalación</span>
          <h2>Robot cortacésped sin cable perimetral: instalación sin <span class="irm-destacado--claro">obras</span></h2>
          <p style="color:var(--irm-gris)">Los robots que instalamos no necesitan cable enterrado alrededor del jardín. No hay zanja, no hay cable que se corte con la azada y no hay que levantar nada. Pepo marca las zonas por las que puede pasar el robot y las que no (piscina, parterres, el arenero de los niños) y lo deja cortando el mismo día.</p>
          <div class="irm-grid irm-grid-2" style="margin-top:1.5rem">
            <article class="irm-card"><h3>También para jardines con pendiente</h3><p style="color:var(--irm-gris)">¿Tu jardín tiene cuesta, escalones de césped o dos zonas separadas? No es un problema. Lo vemos en la demostración.</p></article>
            <article class="irm-card"><h3>Para céspedes de hasta 1.000 m²</h3><p style="color:var(--irm-gris)">Desde el adosado con 200 m² hasta el chalet con 1.000. Si tienes más, cuéntanoslo y buscamos la forma.</p></article>
          </div>
          <p style="margin-top:1.5rem"><a href="/como-funciona/">Cómo funciona paso a paso →</a></p>
        </div>
        <div class="irm-foto"><img src="/img/robot-cortacesped-bordes-pasillo-patio.webp" alt="Robot cortacésped sin cable perimetral junto a un borde" loading="lazy"></div>
      </div>
    </div>
  </section>

  <!-- S6 · PROCESO + FRANJA CTA -->
  <section class="irm-section irm-bg-hueso" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">El proceso</span>
      <h2>Cómo instalamos tu robot cortacésped en Madrid</h2>
      <p style="max-width:62ch;color:var(--irm-gris)">Desde que nos llamas hasta que el robot está cortando pasan pocos días y cero complicaciones. Pepo se desplaza a cualquier punto de la Comunidad de Madrid: la instalación de un robot cortacésped en Madrid la hacemos nosotros, no un transportista.</p>
      <div class="irm-steps" data-stagger>
        <article class="irm-step"><h3>Nos llamas o reservas</h3><p style="color:var(--irm-gris)">Nos cuentas cuántos metros de césped tienes y cómo es el jardín. Con eso ya sabemos qué robot necesitas.</p></article>
        <article class="irm-step"><h3>Demostración en tu jardín</h3><p style="color:var(--irm-gris)">Vamos a tu casa, estudiamos el terreno y te dejamos un robot cortando de prueba. 175 € que se descuentan.</p></article>
        <article class="irm-step"><h3>Instalación y app</h3><p style="color:var(--irm-gris)">Instalamos la base, marcamos las zonas y te configuramos la app en el móvil. Todo en una visita.</p></article>
        <article class="irm-step"><h3>Te olvidas del césped</h3><p style="color:var(--irm-gris)">A partir de ahí, el robot corta solo. Pagas la cuota anual por transferencia y no vuelves a pensar en ello.</p></article>
      </div>
      <div class="irm-cta-strip"><h3>¿Lo vemos en tu jardín?</h3><a href="/demostracion/" class="irm-btn irm-btn-primary irm-on-dark">Pide tu demostración <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a></div>
    </div>
  </section>

  <!-- S7 · PERSONA (Pepo) -->
  <section class="irm-section irm-bg-negro" data-anim>
    <div class="irm-container irm-split">
      <div class="irm-foto"><img src="/img/robot-cortacesped-reparacion-mantenimiento.webp" alt="Pepo trabajando con un robot cortacésped de IRM" loading="lazy"></div>
      <div>
        <span class="irm-eyebrow">Hay una persona detrás</span>
        <h2>Una persona detrás que coge el <span class="irm-destacado">teléfono</span></h2>
        <p>Soy Pepo. Instalo yo los robots, atiendo yo el teléfono y, si algo falla, voy yo a arreglarlo. No hay centralita ni número de incidencia: hay un móvil que suena y una persona que lo coge. Llevo años poniendo robots cortacésped en jardines de Madrid y sé lo que pasa cuando uno se para en julio: por eso te garantizo otro en menos de 7 días.</p>
        <ul class="irm-checks" style="margin-top:1rem">
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Instalo yo</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Atiendo yo el teléfono</li>
          <li><span class="irm-check-ico"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>Sustitución en 7 días</li>
        </ul>
        <a href={`tel:+34${NEGOCIO.telefono}`} style="display:inline-block;margin-top:1.5rem;font:700 2rem/1 var(--font-sans);color:var(--irm-lima);text-decoration:none">{NEGOCIO.telefonoFormato}</a>
      </div>
    </div>
  </section>

  <!-- S8 · PROFESIONALES (3 cards) -->
  <section class="irm-section" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">Para profesionales</span>
      <h2>Robots cortacésped para fincas de bodas, campos de fútbol y empresas</h2>
      <p style="max-width:62ch;color:var(--irm-gris)">El renting también funciona cuando el césped es parte de tu negocio. Ya cortamos el césped de fincas de bodas y campos de fútbol: corte diario, silencioso y con un coste anual cerrado que puedes presupuestar.</p>
      <div class="irm-grid irm-grid-3" data-stagger style="margin-top:2.5rem">
        <a href="/profesionales/fincas-de-bodas-y-eventos/" class="irm-card irm-card--link">
          <div class="irm-foto irm-foto--card"><img src="/img/finca-bodas-cesped-amplio.webp" alt="Césped de finca de bodas con corte diario del robot" loading="lazy"></div>
          <div class="irm-card-body"><h3>Fincas de bodas y eventos</h3><p style="color:var(--irm-gris)">Césped de foto cada fin de semana, sin ruido durante la ceremonia y sin depender del jardinero.</p><span class="irm-arrow">Ver fincas →</span></div>
        </a>
        <a href="/profesionales/campos-de-futbol/" class="irm-card irm-card--link">
          <div class="irm-foto irm-foto--card"><img src="/img/robot-cortacesped-sustitucion-7-dias.webp" alt="Robots cortacésped para clubes deportivos" loading="lazy"></div>
          <div class="irm-card-body"><h3>Campos de fútbol y clubes</h3><p style="color:var(--irm-gris)">Altura uniforme, corte programado entre entrenamientos y coste anual cerrado para la junta.</p><span class="irm-arrow">Ver campos →</span></div>
        </a>
        <a href="/profesionales/" class="irm-card irm-card--link">
          <div class="irm-foto irm-foto--card"><img src="/img/jardin-pergola-piscina-chalet.webp" alt="Zona verde de urbanización" loading="lazy"></div>
          <div class="irm-card-body"><h3>Empresas, hoteles y comunidades</h3><p style="color:var(--irm-gris)">Zonas verdes de polígono, hotel o urbanización con una línea de presupuesto y un solo interlocutor.</p><span class="irm-arrow">Ver profesionales →</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- S9 · ZONAS -->
  <section class="irm-section irm-bg-hueso" data-anim>
    <div class="irm-container">
      <span class="irm-eyebrow">Dónde instalamos</span>
      <h2>Zonas donde instalamos robots cortacésped</h2>
      <p style="max-width:62ch;color:var(--irm-gris)">Trabajamos en toda la Comunidad de Madrid, sobre todo en la periferia, donde están los chalets con jardín: norte, oeste, sur y sierra. Si buscas alquiler de cortacésped en Madrid que vaya solo y no tengas que tocar, te lo llevamos a casa.</p>
      <h3 style="margin-top:2rem">Municipios donde ya instalamos</h3>
