---
// src/components/Hero.astro — sección principal (S1) reutilizable en home y zonas
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  antetitulo: string;
  titulo: string;          // será el H1 de la página
  entradilla: string;
  imagen: ImageMetadata;
  alt: string;
  cta?: { texto: string; href: string };
}
const { antetitulo, titulo, entradilla, imagen, alt,
        cta = { texto: 'Reserva tu robot', href: '/demostracion/' } } = Astro.props;
---
<section class="irm-section irm-bg-negro irm-hero">
  <div class="irm-container irm-hero-grid">
    <div>
      <span class="irm-eyebrow">{antetitulo}</span>
      <h1>{titulo}</h1>
      <p class="irm-entradilla">{entradilla}</p>
      <slot />   <!-- checks, precio, etc. que cambian según la página -->
      <a class="irm-btn" href={cta.href}>{cta.texto}</a>
    </div>
    <!-- Astro optimiza la imagen en el build: tamaño, formato y lazy loading -->
    <Image src={imagen} alt={alt} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 50vw"
           loading="eager" fetchpriority="high" />
  </div>
</section>
