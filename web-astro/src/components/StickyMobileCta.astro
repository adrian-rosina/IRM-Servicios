---
// src/components/StickyMobileCta.astro — barra sticky inferior en móvil con llamada + CTA
import { NEGOCIO } from '../data/negocio';
---
<aside class="irm-sticky-cta" data-sticky-cta>
  <a href={`tel:+34${NEGOCIO.telefono}`} class="irm-sticky-cta__call" aria-label={`Llamar al ${NEGOCIO.telefonoFormato}`}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72a2 2 0 0 1 1.72 2z"/></svg>
    <span>Llamar</span>
  </a>
  <a href="/demostracion/" class="irm-sticky-cta__demo">
    Reserva tu robot
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
  </a>
</aside>

<script is:inline>
(() => {
  const el = document.querySelector('[data-sticky-cta]');
  if (!el) return;
  const show = () => {
    if (window.scrollY > 420) el.classList.add('is-visible');
    else el.classList.remove('is-visible');
  };
  show();
  window.addEventListener('scroll', show, { passive: true });
})();
</script>
